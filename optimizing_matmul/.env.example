export CUDA_HOME=/usr/local/cuda-12.8
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
# Use GPU 2 of the 4 H100s on this host.
export CUDA_VISIBLE_DEVICES=2
# Roofline for scripts/bench.py: dense bf16 tensor-core peak and DRAM bandwidth (see README.md).
export PEAK_TFLOPS=756.4
export MEM_BANDWIDTH_TBPS=2.04
