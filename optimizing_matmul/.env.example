# `.env.example` sets this host's CUDA toolkit, GPU and theoretical peaks; copy it to `.env`.
#
# Interface:
#     CUDA_HOME, PATH, LD_LIBRARY_PATH: the CUDA 12.8 toolkit.
#     CUDA_VISIBLE_DEVICES: GPU 2 of the 4 H100s on this host.
#     NVCC_ARCH: the GPU architecture to build for; sm_90a has the H100's wgmma and TMA.
#     PEAK_DENSE_BF16_TFLOPS_ACCORDING_TO_NVIDIA_SPEC: the roofline's compute peak.
#     MEM_BANDWIDTH_TBYTES_PER_S_ACCORDING_TO_NVIDIA_SPEC: the roofline's bandwidth peak.
#
# Example:
#     cp .env.example .env && source .env
#
# Must know:
#     Gotchas:
#         - Both peaks are H100 PCIe values from README.md; another GPU needs new values.
#         - -arch=native builds sm_90, which lacks wgmma and TMA, so this sets sm_90a.
export CUDA_HOME=/usr/local/cuda-12.8
export PATH=$CUDA_HOME/bin:$PATH
export LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
export CUDA_VISIBLE_DEVICES=2
export NVCC_ARCH=sm_90a
export PEAK_DENSE_BF16_TFLOPS_ACCORDING_TO_NVIDIA_SPEC=756.4
export MEM_BANDWIDTH_TBYTES_PER_S_ACCORDING_TO_NVIDIA_SPEC=2.04
